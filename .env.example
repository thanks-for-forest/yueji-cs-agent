# ===== LLM =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 备选 LLM（DashScope / Qwen）=====
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus

# ===== Embedding（local: bge-small-zh 本地CPU；api: dashscope text-embedding-v3）=====
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_MODEL_SOURCE=modelscope   # modelscope | hf-mirror | huggingface

# ===== Rerank =====
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base

# ===== 检索参数 =====
RETRIEVE_DENSE_TOP_K=20
RETRIEVE_BM25_TOP_K=20
RETRIEVE_FUSION_TOP_K=15
RETRIEVE_RERANK_TOP_K=5
RETRIEVE_MIN_SCORE=0.02

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=8501
RATE_LIMIT_PER_MIN=20

# ===== 可观测（Langfuse，自托管或云）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 检索融合（v2.0）=====
RETRIEVE_FUSION_MODE=dense_first   # dense_first（Dense优先+BM25兜底）| rrf（经典加权）
DENSE_MIN_SIMILARITY=0.55          # 余弦相似度门槛：低于视为"无可信答案"走拒答
