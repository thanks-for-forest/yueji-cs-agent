# ===== 项目环境变量示例 =====
# 复制为 .env 后按需修改（.env 不入库）。键清单与 config/settings.py 严格一致。

# ---------- LLM（主：DeepSeek；备：Ollama） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b

# ---------- Embedding（Ollama bge-m3） ----------
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ---------- Rerank ----------
RERANK_ENABLED=false
RERANK_MODEL=qwen2.5:1.5b

# ---------- 检索参数 ----------
RETRIEVE_DENSE_TOP_K=20
RETRIEVE_BM25_TOP_K=20
RETRIEVE_FUSION_TOP_K=15
RETRIEVE_RERANK_TOP_K=5
RETRIEVE_RRF_K=60
RETRIEVE_FUSION_MODE=dense_first   # dense_first（Dense优先+BM25兜底）| rrf（经典加权）
RETRIEVE_MIN_SCORE=0.02            # RRF 融合分门槛
DENSE_MIN_SIMILARITY=0.55          # 余弦相似度门槛：低于视为"无可信答案"走拒答/澄清

# ---------- Agent / 对话 ----------
MAX_TOOL_ITERS=3
MEMORY_WINDOW=10
SUMMARY_THRESHOLD=20
MAX_SESSION_TURNS=200
TEMPERATURE=0.3
MAX_TOKENS=1024
LLM_RETRY_TIMES=3                 # LLM 限流/5xx/传输错误重试次数（4xx 不重试）
LLM_RETRY_BASE_DELAY=0.5          # 指数退避基数（秒）：0.5, 1, 2…

# ---------- 知识库分块策略（管理后台可调） ----------
KB_CHUNK_SIZE=400
KB_CHUNK_OVERLAP=60
KB_CATEGORIES=活动,新品,公告,常见问题,售后

# ---------- 可观测性（Langfuse，自托管或云；留空=不启用） ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000

# ---------- 权限 ----------
ADMIN_TOKEN=admin123456   # 知识库管理管理员口令（生产必改）

# ---------- 评测时间基准（固定日期消除漂移；生产留空） ----------
# REFERENCE_NOW=2026-08-24T12:00:00

# ---------- 服务 ----------
# 前端访问后端的地址。默认本机；公网部署设为空串 "" = 同源相对路径
API_BASE_URL=http://127.0.0.1:8000
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=8501
RATE_LIMIT_PER_MIN=20
